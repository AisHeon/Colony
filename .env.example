# Colony environment example. Copy to .env.local for local development.
#
# Production database (Vercel deployment).
# Any Postgres connection string works (Neon, Supabase, Vercel Postgres, RDS...).
# Use a pooled connection string when available.
DATABASE_URL=

# Optional: local replication/SSL tuning.
PGSSLMODE=require

# Optional: absolute public origin used when rendering invite links outside a request
# (for example in scripts). The app falls back to the request Host header.
NEXT_PUBLIC_APP_ORIGIN=

# Optional: set to "1" to expose /api/health database diagnostics.
COLONY_HEALTH_DETAILS=1
