/**
 * Exports the seeded content tables as portable SQL (db/seed.sql) so the
 * serverless PGlite fallback can seed itself without Node scripts.
 *
 * Usage: npx tsx scripts/dump-seed.mts
 */
import { writeFile } from "node:fs/promises";
import { getDb } from "../src/lib/db";

const db = await getDb();

const statements: string[] = [
  "-- Generated by scripts/dump-seed.mts from the audited catalog. Do not edit.",
  "-- Content tables only: rooms, matches and reports are never included.",
  "begin;",
];

async function dump(label: string, sql: string) {
  const rows = await db.query<{ stmt: string }>(sql);
  statements.push(`-- ${label}: ${rows.length}`);
  for (const row of rows) statements.push(row.stmt);
}

await dump(
  "entities",
  `select format(
     'insert into entity (id, canonical_name, type, description, meta) values (%L,%L,%L,%L,%L::jsonb) on conflict (id) do nothing;',
     id, canonical_name, type, description, meta::text) as stmt
   from entity order by id`,
);

await dump(
  "aliases",
  `select format(
     'insert into entity_alias (entity_id, alias_norm, display) values (%L,%L,%L) on conflict do nothing;',
     entity_id, alias_norm, display) as stmt
   from entity_alias order by entity_id, alias_norm`,
);

await dump(
  "prompts",
  `select format(
     'insert into prompt (id, kind, text, scope, pack, family_friendly, version, meta) values (%L,%L,%L,%L,%L,%L,%L,%L::jsonb) on conflict (id) do nothing;',
     id, kind, text, scope, pack, family_friendly, version, meta::text) as stmt
   from prompt order by id`,
);

await dump(
  "prompt answers",
  `select format(
     'insert into prompt_answer (prompt_id, entity_id, rarity) values (%L,%L,%L) on conflict do nothing;',
     prompt_id, entity_id, rarity) as stmt
   from prompt_answer order by prompt_id, entity_id`,
);

await dump(
  "graph edges",
  `select format(
     'insert into graph_edge (id, from_entity, predicate, to_entity, forward_label, inverse_label, source, verified, version) values (%L,%L,%L,%L,%L,%L,%L,%L,%L) on conflict (id) do nothing;',
     id, from_entity, predicate, to_entity, forward_label, inverse_label, source, verified, version) as stmt
   from graph_edge order by id`,
);

await dump(
  "puzzles",
  `select format(
     'insert into puzzle (id, start_entity, target_entity, shortest_distance, allowed_predicates, source, version) values (%L,%L,%L,%s,%L::jsonb,%L,%L) on conflict (id) do nothing;',
     id, start_entity, target_entity, shortest_distance, allowed_predicates::text, source, version) as stmt
   from puzzle order by id`,
);

await dump(
  "hopper questions",
  `select format(
     'insert into hopper_question (id, text, scope, source_kind, source_meta, version) values (%L,%L,%L,%L,%L::jsonb,%L) on conflict (id) do nothing;',
     id, text, scope, source_kind, source_meta::text, version) as stmt
   from hopper_question order by id`,
);

await dump(
  "hopper buckets",
  `select format(
     'insert into hopper_bucket (id, question_id, canonical, rank, entity_id, aliases) values (%L,%L,%L,%s,%L,%L::jsonb) on conflict (id) do nothing;',
     id, question_id, canonical, rank, entity_id, aliases::text) as stmt
   from hopper_bucket order by question_id, rank`,
);

await dump(
  "content version",
  `select format(
     'insert into content_meta (key, value) values (%L,%L::jsonb) on conflict (key) do update set value = excluded.value;',
     key, value::text) as stmt
   from content_meta order by key`,
);

statements.push("commit;", "");
await writeFile("db/seed.sql", statements.join("\n"), "utf8");
console.log(`[dump] wrote db/seed.sql with ${statements.length - 4} statements`);
