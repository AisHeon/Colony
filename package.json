{
  "name": "colony",
  "version": "1.0.0",
  "private": true,
  "description": "Colony - a tiny-creature party game collection for friends in one room.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "content:verify": "tsx scripts/verify-content.mts",
    "content:import": "tsx scripts/import-content.mts",
    "test": "tsx --test tests/*.test.ts",
    "test:engine": "node --import tsx --conditions react-server scripts/engine-smoke.mts",
    "test:shared": "node --import tsx --conditions react-server scripts/shared-state-smoke.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vercel/blob": "^2.9.0",
    "@vercel/blob": "^2.9.0",
    "next": "^15.5.4",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
